# Required. Get one at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=

# --- provider fallback (first usable one answers; next takes over on 429/outage) ---
JARVIS_PROVIDERS=gemini   # e.g. groq,cerebras,openrouter,gemini
# GROQ_API_KEY=
# GROQ_MODEL=             # check the model list + Limits page in console.groq.com
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

# --- brain ---
JARVIS_MODEL=gemini-flash-latest
JARVIS_THINKING_LEVEL=medium  # minimal | low | medium | high
JARVIS_MAX_TOKENS=8000

# --- safety ---
JARVIS_REQUIRE_APPROVAL=true  # ask before every write / shell command
JARVIS_ALLOW_WRITES=true
JARVIS_ALLOW_SHELL=true
JARVIS_ALLOW_WEB_SEARCH=true

# --- ears ---
JARVIS_WAKE_WORD=jarvis
JARVIS_WHISPER_MODEL=base.en  # tiny.en | base.en | small.en | medium.en
JARVIS_INPUT_DEVICE=          # index or name substring; blank = system default
JARVIS_SPEECH_RATIO=3.0       # lower = more sensitive
JARVIS_SILENCE_HANG_S=0.9     # silence that ends an utterance

# --- voice ---
JARVIS_TTS=sapi               # sapi | elevenlabs | off
JARVIS_SAPI_VOICE=Zira        # David | Hazel | Zira
JARVIS_SAPI_RATE=185
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- gmail + calendar ---
JARVIS_ENABLE_GOOGLE=true
JARVIS_TIMEZONE=Asia/Kolkata   # used when creating calendar events
# GOOGLE_CREDENTIALS_PATH=     # defaults to ./credentials.json
# GOOGLE_TOKEN_PATH=           # defaults to ./google_token.json
